DATABASE_URL=postgresql+psycopg://urbanization:urbanization@localhost:5432/urbanization_tracker
REDIS_URL=redis://localhost:6379/0
INGESTION_DATA_DIR=./data
HOSTED_INGESTION_ENABLED=false
ARTIFACT_DURABILITY_REQUIRED=false
ARTIFACT_SINK=local
ARTIFACT_SINK_ID=local-development
# Hosted ingestion requires ARTIFACT_DURABILITY_REQUIRED=true and ARTIFACT_SINK=s3.
# Configure a private S3-compatible bucket and server-side credentials before enabling it.
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY=
ARTIFACT_S3_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEWER_API_TOKEN=
PHASE3_STORE_BACKEND=artifact
PROCESSED_STORE_BACKEND=artifact
PUBLIC_BASE_URL=http://localhost:5173
ALERT_DELIVERY_ENABLED=false
ALERT_DELIVERY_RATE_LIMIT=25
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
VITE_API_BASE_URL=http://localhost:8000
PUBLIC_WRITE_QUOTA_SECRET=
PUBLIC_WRITE_QUOTA_LIMIT=10
PUBLIC_WRITE_TRUSTED_PROXIES=
PUBLIC_WATCH_MAX_AREA_SQ_KM=2500
